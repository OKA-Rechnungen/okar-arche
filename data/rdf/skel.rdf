   <acdh:TopCollection rdf:about="https://id.acdh.oeaw.ac.at/wstla_oka-rechnungsbuecher-stadtwien">
      <acdh:hasPid>create</acdh:hasPid>
      <acdh:hasTitle xml:lang="de">Rechnungsbücher des Oberkammeramtes der Stadt Wien</acdh:hasTitle>
      <acdh:hasDescription xml:lang="de">Die Sammlung enthält 289 digitalisierte Rechnungsbücher des Oberkammeramtes der Stadt Wien aus der Zeit von 1424 bis 1768. Die Digitalisierung und Tiefenerschließung erfolgte 2024–2026 am Wiener Stadt- und Landesarchiv sowie am Austrian Centre for Digital Humanities im Projekt „Digitale Erschließung der Oberkammeramtsrechnungen der Stadt Wien“, gefördert durch das Bundesministerium für Wohnen, Kunst, Kultur, Medien und Sport im Förderprogramm „Kulturerbe digital“ und finanziert aus EU.</acdh:hasDescription>
      <acdh:hasContact rdf:resource="https://id.acdh.oeaw.ac.at/rklugseder"/>
      <acdh:hasMetadataCreator rdf:resource="https://id.acdh.oeaw.ac.at/fsanzlazaro"/>
      <acdh:hasDepositor rdf:resource="https://id.acdh.oeaw.ac.at/brigele"/>
      <acdh:hasEditor rdf:resource="https://d-nb.info/gnd/2060831-7"/>
      <acdh:hasEditor rdf:resource="https://id.acdh.oeaw.ac.at/rklugseder"/>
      <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/junterholzner"/>
      <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/fsanzlazaro"/>
      <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/dschopper" />
      <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/mswatek" />
      <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/jveitschegger" />
        <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/anekula" />                                                                                                                                                              
        <acdh:hasContributor rdf:resource="https://id.acdh.oeaw.ac.at/krauch" />
      <acdh:hasCoverageStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1424-01-01</acdh:hasCoverageStartDate>
      <acdh:hasCoverageEndDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1767-12-31</acdh:hasCoverageEndDate>
      <acdh:hasSubject xml:lang="de">Rechnungsbuch</acdh:hasSubject>
      <acdh:hasLanguage rdf:resource="https://vocabs.acdh.oeaw.ac.at/iso6393/deu"/>
      <acdh:hasRelatedDiscipline rdf:resource="https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/601020"/>
      <acdh:hasRelatedDiscipline rdf:resource="https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/601029"/>
      <acdh:hasRelatedDiscipline rdf:resource="https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/605007"/>
      <acdh:hasRelatedDiscipline rdf:resource="https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/601012"/>
      <acdh:hasRelatedDiscipline rdf:resource="https://vocabs.acdh.oeaw.ac.at/oefosdisciplines/601016"/>                                 
      <acdh:hasNamingScheme xml:lang="de">Bilddateien sind als „WSTLA-OKA-B1-1-[001-289]-[1-2]_[001-999].tif” und XML-Dateien sind als „WSTLA-OKA-B1-1-[001-289]-[1-2].xml” benannt.</acdh:hasNamingScheme>
      <acdh:hasLifeCycleStatus rdf:resource="https://vocabs.acdh.oeaw.ac.at/archelifecyclestatus/active"/>
      <acdh:hasFunder rdf:resource="https://id.acdh.oeaw.ac.at/bmwkms" />
      <acdh:hasArrangement xml:lang="de">
        Die Sammlung umfasst die Sammlungen „Master-Scans“ und „Bearbeitete Digitalisate“, jeweils mit einer Untersammlung für jeden Band, die ein Bild jeder Seite des jeweiligen Bandes enthalten.  
        Die Sammlung „TEI-XML-Editionen“ enthält die TEI-XML-Editionen der Bände.  
        Die Sammlung „TEI-XML“ umfasst ebenfalls eine Untersammlung pro Band mit jeweils einer PAGE-XML-Datei pro Seite.  
        Die Sammlung „Ergänzende Materialien“ enthält diverse Dateien.
      </acdh:hasArrangement>
      <acdh:hasFunderLogo>https://shared.acdh.oeaw.ac.at/arche-funder-logos/BMWKMS_Logo_srgb.png</acdh:hasFunderLogo>
      <acdh:hasFunder rdf:resource="https://id.acdh.oeaw.ac.at/europeanunion" />
      <acdh:hasFunderLogo>https://shared.acdh.oeaw.ac.at/arche-funder-logos/EU_nextgen.png</acdh:hasFunderLogo>
