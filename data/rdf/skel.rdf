    <acdh:TopCollection rdf:about="https://id.acdh.oeaw.ac.at/okar">
      <acdh:hasPid>create</acdh:hasPid>
      <acdh:hasTitle xml:lang="de">Oberkammeramtsrechnungsbücher der Stadt Wien</acdh:hasTitle> 
	   <acdh:hasDescription xml:lang="de">Die Sammlung enthaltet 289 digitalisierte Oberkammeramtsrechnungsbücher der Stadt Wien aus der Zeit von 1424 bis 1768.</acdh:hasDescription>
